# Copy the values from the existing Oracle development schema. Do not commit real credentials.
RHN_ORACLE_URL=jdbc:oracle:thin:@//database-host:1521/service-name
RHN_ORACLE_USER=application-schema-user
RHN_ORACLE_PASSWORD=replace-with-local-secret

# Production deployments must provide a unique Base64-encoded 32-byte key for dynamic API-key encryption.
# RHN_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# RHN_SECRET_ENCRYPTION_KEY_ID=primary

# Optional native clinical AI. Keep the key in this gitignored server-side file.
# RHN_AI_MODE=MODEL
# RHN_AI_PROVIDER=openai-compatible
# RHN_AI_MODEL=gpt-4o-mini
# RHN_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# RHN_AI_API_KEY=replace-with-server-side-secret
# RHN_AI_REQUEST_TIMEOUT=PT45S
# RHN_AI_MAX_OUTPUT_TOKENS=3000
# RHN_AI_SPEECH_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
# RHN_AI_SPEECH_MODEL=gpt-transcribe
# RHN_AI_MAX_AUDIO_BYTES=20971520
# Optional PMPHAI-compatible search endpoint. The AI API key is reused when this key is omitted.
# RHN_AI_KNOWLEDGE_ENDPOINT=https://your-ai-gateway.example/v1/knowledge/pmphai/search
# RHN_AI_KNOWLEDGE_API_KEY=replace-with-server-side-secret
# RHN_AI_MAX_KNOWLEDGE_RESULTS=5
# Optional rollout controls. Both allowlists must match when both are configured.
# RHN_AI_ROLLOUT_ORGANIZATION_IDS=362387869790211
# RHN_AI_ROLLOUT_DEPARTMENT_IDS=362387869790212
# RHN_AI_ROLLOUT_PERCENTAGE=10
