<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rhn</groupId>
        <artifactId>rhn-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>rhn-app</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-health-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-work</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-clinical</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-public-health</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-care</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-quality</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-intelligence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rhn</groupId>
            <artifactId>rhn-analytics</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Surefire already runs it; declared so RhnTestJvmSlot can compile against LauncherSessionListener. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <properties>
        <!-- 3 forks roughly halved the full backend suite when introduced (918s -> 454s); the suite has since grown
             to ~1330-1430s with 3 forks (verify-scope full runs, 2026-10-13). CI passes a smaller value. -->
        <rhn.test.forks>3</rhn.test.forks>
    </properties>

    <build>
        <finalName>rhn-application-${project.version}</finalName>
        <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/../src/main/resources</directory>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${project.basedir}/../src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <!-- Business dates and sessions are Asia/Shanghai (organization default); pin the test JVM so
                         LocalDate.now() in tests and server code agree regardless of the machine or CI timezone. -->
                    <argLine>-Xmx4g -Duser.timezone=Asia/Shanghai</argLine>
                    <!-- Separate JVMs, each with its own context cache and random H2 databases; JUnit
                         in-JVM parallelism stays off (database reset requires it). Override with -Drhn.test.forks=N. -->
                    <forkCount>${rhn.test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <spring.test.context.cache.maxSize>8</spring.test.context.cache.maxSize>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
