      },
      {
        "code": "status",
        "name": "就诊状态",
        "databaseType": "VARCHAR2",
        "unit": "",
        "aggregates": [],
        "operators": [
          "EQ",
          "IN"
        ],
        "values": {
          "COMPLETED": "诊毕",
          "CANCELLED": "退号",
          "IN_PROGRESS": "接诊中",
          "TRANSFERRED": "转科",
          "REGISTERED": "已挂号",
          "SUSPENDED": "暂挂",
          "TERMINATED": "终止"
        }
      }
    ]
  },
