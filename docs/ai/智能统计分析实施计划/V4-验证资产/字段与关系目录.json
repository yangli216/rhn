  {
    "code": "ENCOUNTER",
    "version": 1,
    "name": "门诊就诊",
    "grain": "每次就诊一行",
    "definition": "按就诊登记日期统计门诊就诊；默认包含所有当前就诊状态，可筛选状态。患者去重是当前查询范围内去重，各分组合计不一定等于去重总人数。",
    "relation": "RHN_VIS_ENC 为就诊主表，ID_ENC 唯一；机构及科室权限按就诊归属控制。",
    "dimensions": [
      "DAY",
      "MONTH",
      "DEPARTMENT",
      "STATUS"
    ],
    "fields": [
      {
        "code": "encounterId",
        "name": "就诊次数",
