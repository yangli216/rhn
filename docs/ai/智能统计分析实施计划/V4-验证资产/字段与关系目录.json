[
  {
    "code": "CHARGE",
    "version": 1,
    "name": "门诊费用明细",
    "grain": "每条已记账费用明细一行，含负数冲销行",
    "definition": "按费用发生日期统计已绑定门诊就诊的人民币已记账费用，含未结算费用，冲销以负数计入净发生额；不是实际收款、已结算收入或医保到账。未绑定就诊的费用不计入。平均金额是每条费用行均值，不是次均费用；去重就诊或患者含冲销涉及对象。",
    "relation": "RHN_BIL_CHARGE_ITEM → RHN_VIS_ENC：ID_ENC + ID_TNT，多对一；费用通过 ID_CARE_REQ + ID_TNT + ID_ENC 左关联 RHN_EX_CARE_REQ（多对一）；可按关联医嘱类别和状态筛选，未关联医嘱的费用仅在不筛选医嘱条件时保留。",
    "dimensions": [
      "DAY",
      "MONTH",
      "DEPARTMENT",
      "ITEM",
      "ORDER_TYPE"
    ],
    "fields": [
      {
        "code": "chargeId",
        "name": "费用明细条数",
        "databaseType": "NUMBER",
        "unit": "条",
        "aggregates": [
          "COUNT",
          "COUNT_DISTINCT"
        ],
        "operators": [],
        "values": {}
      },
      {
        "code": "encounterId",
        "name": "涉及就诊",
        "databaseType": "NUMBER",
        "unit": "人次",
        "aggregates": [
          "COUNT",
          "COUNT_DISTINCT"
        ],
        "operators": [],
        "values": {}
      },
      {
        "code": "patientId",
        "name": "涉及患者",
