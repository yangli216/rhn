{
  "name": "rhn-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "check": "npm run ui:check && npm run schema:test && npm run test && npm run build",
    "test": "vitest run",
    "ui:check": "npm run ui:policy:test && node scripts/check-ui-standards.mjs",
    "ui:policy": "node scripts/check-ui-policy.mjs",
    "ui:policy:test": "node --test scripts/ui-policy.node-test.mjs",
    "api:generate": "openapi-typescript ../docs/api/openapi.json -o src/shared/api/generated.ts",
    "schema:refresh": "node ../scripts/schema-workbench/cli.mjs refresh",
    "schema:context": "node ../scripts/schema-workbench/cli.mjs context",
    "schema:check": "node ../scripts/schema-workbench/cli.mjs check",
    "schema:test": "node --test ../scripts/schema-workbench/*.test.mjs",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.3",
    "@yangl/canvas-editor": "file:vendor/yangl-canvas-editor-0.9.133.tgz",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.26",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
